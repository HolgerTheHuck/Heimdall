<?xml version="1.0" encoding="utf-8"?>
<!-- Zentrale Build-Eigenschaften fuer den Heimdall-Baum.

     Heimdall ist eine eingebettbare OTel-Infrastruktur fuer .NET:
     empfängt OTLP, speichert Traces/Logs/Metriken in Walhalla (embedded)
     und zeigt sie via Blazor (embedded) bzw. REST-SPI + Svelte (public).
     Siehe DESIGN.md.

     Konventionen (an Walhalla angelehnt):
       - Doku/Kommentare auf Deutsch.
       - Kernbibliotheken ohne ImplicitUsings (explizite usings), API/Tests mit.
       - Mehrfach-Targeting net8/9/10 fuer Bibliotheken; Executables/Tests net10. -->
<Project>
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>
</Project>