{
  "Kestrel": {
    "Endpoints": {
      "http-ui": {
        "Url": "http://0.0.0.0:5099",
        "Protocols": "Http1AndHttp2"
      },
      "grpc-otlp": {
        "Url": "http://0.0.0.0:4317",
        "Protocols": "Http2"
      }
    }
  },
  "Heimdall": {
    "Storage": {
      "Backend": "sqlite",
      "DataPath": "var/heimdall/otel.db",
      "RetentionDays": 7,
      "Retention": {
        "TracesDays": 3,
        "LogsDays": 14,
        "MetricsDays": 30
      },
      "MaxBytes": 0,
      "RetentionSweepMinutes": 30,
      "WalMode": true,
      "AutoVacuum": true,
      "VacuumMigrateLegacy": true,
      "Rollup": { "Enabled": false, "ResolutionSeconds": 60, "RawDays": 1 }
    },
    "Otlp": {
      "Http": { "Enabled": true, "Prefix": "/otel", "MaxConcurrentRequests": 32 },
      "Grpc": { "Enabled": true, "Url": "http://localhost:4317", "MaxConcurrentRequests": 32 }
    },
    "Prometheus": { "Enabled": true, "Prefix": "/otel" },
    "Dashboard": { "Enabled": true, "Prefix": "/otel" },
    "DashboardsStore": { "Dir": "var/heimdall/dashboards", "SeedExample": false },
    "Alerting": {
      "Enabled": false,
      "EvaluationIntervalSeconds": 15,
      "RulesDir": "var/heimdall/alerts/rules",
      "StateDir": "var/heimdall/alerts",
      "Smtp": { "Enabled": false, "Host": null, "Port": 587, "From": null, "To": null, "UseTls": true },
      "Webhook": { "Enabled": false, "Url": null, "TimeoutSeconds": 10 },
      "LoggerEnabled": true
    },
    "Auth": { "Enabled": true, "Username": "admin", "Password": "change-me", "ApiKey": "" },
    "Ui": {
      "TrustedOrigins": []
    },
    "SeedDemoData": false
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  }
}