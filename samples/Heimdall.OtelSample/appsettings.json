{
  "Heimdall": {
    "Auth": {
      // Opt-in Login-Schutz für die Heimdall-Oberfläche (/otel/*). Aktiviert:
      // Browser zeigt beim Öffnen von /otel die Login-Seite (Username + Password,
      // Session-Cookie mit Timeout). Die App-eigenen Routes (/api/...) bleiben
      // frei (ProtectedPrefix wird im Program.cs auf "/otel" gesetzt). Für die
      // Prometheus-API (/otel/api/v1/*) zusätzlich ApiKey setzen (x-heimdall-key).
      "Enabled": true,
      "Username": "admin",
      "Password": "change-me",
      "ApiKey": "change-me-too"
    },
    "SelfTelemetry": {
      // Heimdall-Eigentelemetrie erfassen? false (Default) = der Heimdall-Exporter
      // verwirft Spans/Metriken der Dashboard-Routes (/otel/*) und Logs der
      // Kategorie Heimdall.*, damit das Bedienen des Heimdall-UIs die zu
      // beobachtende App nicht verrauscht. true = alles erfassen (nur wenn man
      // Heimdall selbst untersuchen will).
      "Enabled": false
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  }
}