{
  "Heimdall": {
    "Auth": {
      // Opt-in Login-Schutz für die Heimdall-Oberfläche (/otel/*). Default aus.
      // Aktiviert: Browser zeigt beim Öffnen von /otel einen Basic-Auth-Dialog
      // (Username + Password). Die App-eigenen Routes (/api/...) bleiben frei
      // (ProtectedPrefix wird im Program.cs auf "/otel" gesetzt). Für die
      // Prometheus-API (/otel/api/v1/*) zusätzlich ApiKey setzen (x-heimdall-key).
      // Beispiel:
      //   "Enabled": true,
      //   "Username": "admin",
      //   "Password": "change-me",
      //   "ApiKey": "change-me-too"
      "Enabled": false,
      "Username": null,
      "Password": null,
      "ApiKey": null
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  }
}