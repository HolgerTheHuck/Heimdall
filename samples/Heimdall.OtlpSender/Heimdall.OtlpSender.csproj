<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Heimdall.OtlpSender</RootNamespace>
    <AssemblyName>Heimdall.OtlpSender</AssemblyName>
    <!-- Konsolen-Sample, kein NuGet-Paket (wie die anderen Samples). -->
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <!-- Echter OTel-SDK-Export via OTLP (HTTP-Protobuf + gRPC) gegen den
         Stand-alone-Host. Versionsspiegelung zu Heimdall.Sdk (1.16.0). -->
    <PackageReference Include="OpenTelemetry" Version="1.16.0" />
    <PackageReference Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="1.16.0" />
  </ItemGroup>

</Project>