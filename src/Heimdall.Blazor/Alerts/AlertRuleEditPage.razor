@* Alarm-Regel-Editor (neu + bearbeiten). POST-Form ohne JS — alle signal-
   spezifischen Felder werden gezeigt; irrelevant werden server-seitig ignoriert.
   Submit -> /alerts/save -> Detail-Seite. Statisches SSR. *@
@using System
@using System.Globalization
@using Heimdall.Blazor.Alerts
@inject IAlertRuleStore Store
@inject HeimdallAlertingOptions Options
@inject Heimdall.Blazor.IHeimdallI18n I18n

<HeimdallDocument Title="@I18n.T("page.title.alertRule")" BasePath="@BasePath">
    <h1>@(string.IsNullOrEmpty(Id) ? I18n.T("alert.editor.heading.new") : I18n.T("alert.editor.heading.edit"))</h1>
    <p class="hmd-dim"><a class="hmd-back" href="@(BasePath + "/alerts")">@I18n.T("alert.detail.back")</a></p>

    @if (!string.IsNullOrEmpty(Error))
    {
        <p class="hmd-err-msg" role="alert">@Error</p>
    }

    <form method="post" action="@(BasePath + "/alerts/save")" class="hmd-form">
        <input type="hidden" name="id" value="@Id" />

        <fieldset>
            <legend>@I18n.T("alert.editor.legend.general")</legend>
            <label>@I18n.T("alert.col.name") <input type="text" name="name" value="@_name" required /></label>
            <label class="hmd-check"><input type="checkbox" name="enabled" value="1" checked="@_enabled" /> @I18n.T("alert.editor.field.enabled")</label>
            <label>@I18n.T("alert.col.signal")
                <select name="signal">
                    <option value="Metric" selected="@(_signal == AlertSignal.Metric)">@I18n.T("alert.editor.signal.metric")</option>
                    <option value="Log" selected="@(_signal == AlertSignal.Log)">@I18n.T("alert.editor.signal.log")</option>
                    <option value="Trace" selected="@(_signal == AlertSignal.Trace)">@I18n.T("alert.editor.signal.trace")</option>
                </select>
            </label>
            <label>@I18n.T("alert.detail.col.description") <input type="text" name="description" value="@_description" /></label>
        </fieldset>

        <fieldset>
            <legend>@I18n.T("alert.editor.legend.metric")</legend>
            <p class="hmd-dim">@I18n.T("alert.editor.metric.hint")<code>sum(rate(http_requests_total{status=~"5.."}[5m])) &gt; 0</code></p>
            <label>PromQL <textarea name="promql" rows="2" class="hmd-mono">@_promql</textarea></label>
        </fieldset>

        <fieldset>
            <legend>@I18n.T("alert.editor.legend.log")</legend>
            <p class="hmd-dim">@I18n.T("alert.editor.log.hint.a")<code>body</code>@I18n.T("alert.editor.log.hint.b")</p>
            <label>@I18n.T("alert.detail.col.logtext") <input type="text" name="logText" value="@_logText" placeholder="@I18n.T("alert.editor.placeholder.logtext")" /></label>
            <label>@I18n.T("alert.detail.col.minseverity") <input type="number" name="minSeverity" value="@(_minSeverity?.ToString(CultureInfo.InvariantCulture))" placeholder="17=ERROR, 13=WARN, 9=INFO" /></label>
        </fieldset>

        <fieldset>
            <legend>@I18n.T("alert.editor.legend.trace")</legend>
            <p class="hmd-dim">@I18n.T("alert.editor.trace.hint")</p>
            <label class="hmd-check"><input type="checkbox" name="hasError" value="1" checked="@(_hasError == true)" /> @I18n.T("alert.detail.col.errtraces")</label>
            <label>Service <input type="text" name="serviceName" value="@_serviceName" /></label>
            <label>@I18n.T("traces.filter.name") <input type="text" name="nameContains" value="@_nameContains" /></label>
        </fieldset>

        <fieldset>
            <legend>@I18n.T("alert.editor.legend.window")</legend>
            <label>@I18n.T("alert.editor.field.window") <input type="number" name="windowSeconds" value="@_windowSeconds.ToString(CultureInfo.InvariantCulture)" /></label>
            <label>@I18n.T("alert.detail.col.threshold") <input type="number" name="threshold" value="@_threshold.ToString(CultureInfo.InvariantCulture)" /></label>
            <label>@I18n.T("alert.editor.field.for") <input type="number" name="forSeconds" value="@_forSeconds.ToString(CultureInfo.InvariantCulture)" placeholder="@I18n.T("alert.editor.placeholder.for")" /></label>
            <label>@I18n.T("alert.editor.field.evalinterval") <input type="number" name="evalInterval" value="@_evalInterval.ToString(CultureInfo.InvariantCulture)" placeholder="@I18n.T("alert.editor.placeholder.eval")" /></label>
        </fieldset>

        <fieldset>
            <legend>@I18n.T("alert.editor.legend.channels")</legend>
            <div class="hmd-check-row">
                <label class="hmd-check"><input type="checkbox" name="channels" value="logger" checked="@_channels.Contains("logger")" /> logger @(Options.LoggerEnabled ? "" : I18n.T("alert.editor.channel.disabled"))</label>
                <label class="hmd-check"><input type="checkbox" name="channels" value="email" checked="@_channels.Contains("email")" /> email @(Options.Smtp.Enabled ? "" : I18n.T("alert.editor.channel.disabled"))</label>
                <label class="hmd-check"><input type="checkbox" name="channels" value="webhook" checked="@_channels.Contains("webhook")" /> webhook @(Options.Webhook.Enabled ? "" : I18n.T("alert.editor.channel.disabled"))</label>
            </div>
        </fieldset>

        <div class="hmd-form-actions">
            <button type="submit" class="hmd-btn">@I18n.T("alert.editor.save")</button>
            <a class="hmd-btn hmd-btn-ghost" href="@(BasePath + "/alerts")">@I18n.T("alert.editor.cancel")</a>
        </div>
    </form>
</HeimdallDocument>

@code {
    [Parameter] public string BasePath { get; set; } = "/otel";
    [Parameter] public string? Id { get; set; }
    [Parameter] public string? Error { get; set; }

    private string _name = "";
    private bool _enabled = true;
    private AlertSignal _signal = AlertSignal.Metric;
    private string? _promql, _logText, _serviceName, _nameContains, _description;
    private int? _minSeverity;
    private bool? _hasError;
    private long _windowSeconds = 300;
    private int _threshold = 0;
    private long _forSeconds = 0;
    private long _evalInterval = 0;
    private HashSet<string> _channels = new();

    protected override void OnInitialized()
    {
        if (!string.IsNullOrEmpty(Id))
        {
            var rule = Store.Get(Id);
            if (rule is not null)
            {
                _name = rule.Name;
                _enabled = rule.Enabled;
                _signal = rule.Signal;
                _promql = rule.Promql;
                _logText = rule.LogText;
                _minSeverity = rule.MinSeverity;
                _hasError = rule.HasError;
                _serviceName = rule.ServiceName;
                _nameContains = rule.NameContains;
                _windowSeconds = rule.WindowSeconds;
                _threshold = rule.Threshold;
                _forSeconds = rule.ForSeconds;
                _evalInterval = rule.EvalIntervalSeconds;
                _description = rule.Description;
                _channels = rule.Channels is null ? new() : new HashSet<string>(rule.Channels, StringComparer.OrdinalIgnoreCase);
            }
        }
    }
}