@namespace Heimdall.Blazor
@* Gemeinsamer <head>-Block: Charset, Titel, Favicon (SVG-Data-URI), Theme-Color,
   Heimdall-CSS + Progressive-Enhancement-JS (Static-Web-Assets). Asset-URLs tragen
   die Request-PathBase (IIS-Unterverzeichnis/Proxy-Pfad-Strip) — am App-Root
   (PathBase leer) identisch mit dem bisherigen absoluten Pfad. Der Accessor ist
   via AddHeimdallDashboard registriert (dorthin führt jeder Dashboard-Einsatz). *@
@inject Microsoft.AspNetCore.Http.IHttpContextAccessor Http
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
@* Theme-Color pro Schema (dunkel = Nacht, hell = Tagwacht) — die Browser-Chrome
   folgt damit der selben OS-Vorgabe wie die Tokens. Favicon: Heimdall-Marke
   (Zielfernrohr + Bifröst-Bogen) als SVG-Data-URI — hier mit Literal-Farben,
   ein Favicon hat keinen CSS-Kontext. *@
<meta name="theme-color" media="(prefers-color-scheme: dark)" content="#0B0F1A" />
<meta name="theme-color" media="(prefers-color-scheme: light)" content="#F3F5F9" />
<title>@Title — Heimdall</title>
<link rel="icon" href="data:image/svg+xml,%3Csvg%20xmlns='http://www.w3.org/2000/svg'%20viewBox='0%200%2024%2024'%20fill='none'%3E%3Cdefs%3E%3ClinearGradient%20id='g'%20x1='4.5'%20y1='12'%20x2='19.5'%20y2='12'%20gradientUnits='userSpaceOnUse'%3E%3Cstop%20offset='0'%20stop-color='%235B8DEF'/%3E%3Cstop%20offset='.34'%20stop-color='%233AA37C'/%3E%3Cstop%20offset='.67'%20stop-color='%23E7C46A'/%3E%3Cstop%20offset='1'%20stop-color='%23E8604C'/%3E%3C/linearGradient%3E%3C/defs%3E%3Cpath%20d='M4.5%2012a7.5%207.5%200%200%201%2015%200'%20stroke='url(%23g)'%20stroke-width='2.4'%20stroke-linecap='round'/%3E%3Ccircle%20cx='12'%20cy='12'%20r='7.5'%20stroke='%23E7C46A'%20stroke-width='1.8'/%3E%3Ccircle%20cx='12'%20cy='12'%20r='1.7'%20fill='%23E7C46A'/%3E%3C/svg%3E" />
<link rel="stylesheet" href="@Asset("css/heimdall.css")" />
<script src="@Asset("js/heimdall.js")" defer></script>

@code {
    [Parameter] public string Title { get; set; } = "Heimdall";

    /// <summary>App-root-relativer Asset-Pfad mit PathBase (IHeimdallUiPaths.AssetBase).</summary>
    private string Asset(string rel) =>
        HeimdallUiPaths.AssetBase(Http.HttpContext) + "/_content/Heimdall.Blazor/" + rel;
}