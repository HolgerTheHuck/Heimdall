@namespace Heimdall.Blazor
@* Geteilte Log-Zeile (EIN <tr> pro Log), Seq-style: kompakter Einzeiler, aufklappbar
   für strukturierte Details. Genutzt von LogsPage, TraceDetailPage, DashboardPage,
   HomePage und Grafana-Log-Panels. Spalten: Zeit | Sev | Body | Trace.
   Body ist ein <details>: <summary> zeigt den Log-Text als Einzeiler (mit Ellipsis,
   solange zugeklappt) — so bleiben viele Logs kompakt übereinander; aufgeklappt
   erscheinen die strukturierten Attribute + Trace/Span/Scope/Severity darunter.
   TraceId-Spalte ist ein Link auf das Trace-Detail. Rein nativ, kein JS.
   Spalten (ShowService=false): Zeit | Sev | Body | Trace. Mit ShowService=true
   (flache Logs-Liste) kommt der Service zwischen Zeit und Sev. *@
@using System.Collections.Generic
@inject Heimdall.Blazor.IHeimdallI18n I18n
<tr class="@SevClass()">
    <td class="hmd-mono">@HeimdallFmt.Ts(Log.TimeUnixNano)</td>
    @if (ShowService)
    {
        @* Service-Spalte (Opt-in, Logs-Liste): service.name aus dem Attr-Index.
           In der gruppierten Ansicht entfaellt sie (steht in der Gruppenueberschrift). *@
        <td class="hmd-mono hmd-log-svc">
            @if (!string.IsNullOrEmpty(Log.ServiceName))
            {
                @Log.ServiceName
            }
            else
            {
                <span class="hmd-dim">—</span>
            }
        </td>
    }
    <td><span class="hmd-badge">@HeimdallFmt.Sev(Log.Severity)</span></td>
    <td class="hmd-log-body-cell">
        <details class="hmd-log-details" open="@Expand">
            <summary class="hmd-log-summary">@Log.Body</summary>
            <div class="hmd-log-full">
                @if (_attrs.Count > 0)
                {
                    @* Attributwert ist klickbar: uebernimmt {key="value"} als LogQL-
                       Filter auf der Logs-Seite. Der Reflex aus Seq/Grafana — „zeig
                       mir alle Logs mit diesem Wert" — war bisher nur per Hand ins
                       Suchfeld zu tippen. Nicht-adressierbare Schluessel (Zeichen,
                       die der Stream-Selector nicht liest) bleiben reiner Text. *@
                    <dl class="hmd-attr-list">
                        @foreach (var a in _attrs)
                        {
                            <dt>@a.Key</dt>
                            var fu = FilterUrl(a.Key, a.Value);
                            @if (fu is null)
                            {
                                <dd>@a.Value</dd>
                            }
                            else
                            {
                                <dd><a class="hmd-attr-filter" href="@fu"
                                       title="@I18n.T("logs.attr.filter", a.Key, a.Value)">@a.Value</a></dd>
                            }
                        }
                    </dl>
                }
                else
                {
                    <p class="hmd-dim">@I18n.T("trace.attrs.none")</p>
                }
                <dl class="hmd-attr-list hmd-attr-ids">
                    <dt>trace</dt><dd class="hmd-mono">@(Log.TraceId ?? "—")</dd>
                    <dt>span</dt><dd class="hmd-mono">@(Log.SpanId ?? "—")</dd>
                    <dt>scope</dt><dd>@(Log.ScopeName ?? "—")</dd>
                    <dt>severity</dt><dd>@(Log.SeverityText ?? HeimdallFmt.Sev(Log.Severity))</dd>
                </dl>
            </div>
        </details>
    </td>
    <td class="hmd-mono hmd-log-trace">
        @if (!string.IsNullOrEmpty(Log.TraceId))
        {
            @* title = volle TraceId: die Spalte kuerzt auf 12 Zeichen, sonst ist der
               vollstaendige Wert nirgends erreichbar (Hover + Kopieren aus dem Tooltip).
               ret= traegt die aktuelle Seite (samt Filtern) an das Trace-Detail durch,
               damit dessen Zurueck-Link zur wirklichen Herkunft fuehrt (Logs, Dashboard,
               Home, …) statt fest auf /traces. *@
            <a href="@(BasePath + "/trace/" + Log.TraceId + RetSuffix())" title="@Log.TraceId">@HeimdallFmt.Truncate(Log.TraceId, 12)</a>
        }
        else
        {
            <span class="hmd-dim">—</span>
        }
    </td>
</tr>

@code {
    /// <summary>Die darzustellende Log-Zeile.</summary>
    [Parameter] public Heimdall.LogRow Log { get; set; } = default!;
    /// <summary>Mount-Pfad des Dashboards (für Trace-Links).</summary>
    [Parameter] public string BasePath { get; set; } = "/otel";
    /// <summary><c>true</c> → <c>&lt;details open&gt;</c> (alle aufgeklappt).</summary>
    [Parameter] public bool Expand { get; set; }
    /// <summary><c>true</c> → zusätzliche Service-Spalte (service.name). Opt-in
    /// für die flache Logs-Liste; Trace-Detail/Dashboard-Panels bleiben unverändert.</summary>
    [Parameter] public bool ShowService { get; set; }

    /// <summary>
    /// Query-String-Anhang (ohne fuehrendes <c>&amp;</c>), den die Attribut-Filter-
    /// Links mitnehmen — die Logs-Seite reicht hier ihren aktiven Zeitraum durch,
    /// damit ein Klick nicht stillschweigend auf den Default-Zeitraum zurueckfaellt.
    /// Leer = Logs-Seite entscheidet selbst.
    /// </summary>
    [Parameter] public string? ExtraQuery { get; set; }

    // Statisches SSR: HttpContext als CascadingParameter (wie HeimdallNav.CurrentUrl),
    // um die aktuelle Anfrage-URL fuer den ret=-Parameter des Trace-Links zu bilden.
    [Microsoft.AspNetCore.Components.CascadingParameter]
    public Microsoft.AspNetCore.Http.HttpContext? HttpContext { get; set; }

    private IReadOnlyList<HeimdallCharting.AttrKv> _attrs = Array.Empty<HeimdallCharting.AttrKv>();

    protected override void OnInitialized()
    {
        _attrs = HeimdallCharting.ParseAttrs(Log.AttrsJson);
    }

    /// <summary>
    /// <c>?ret=&lt;aktuelle-URL&gt;</c> fuer den Trace-Link, oder leerer String ohne
    /// HttpContext (z. B. Unit-Render ausserhalb eines Requests). Traegt PathBase +
    /// Pfad + Query-String — dieselbe Form wie <see cref="HeimdallNav.CurrentUrl"/> —
    /// damit TraceDetailPage sie unveraendert als Zurueck-Ziel uebernehmen kann.
    /// </summary>
    private string RetSuffix()
    {
        if (HttpContext is null) return string.Empty;
        var req = HttpContext.Request;
        var full = req.PathBase.Value + req.Path.Value + req.QueryString.Value;
        return "?ret=" + Uri.EscapeDataString(full);
    }

    /// <summary>
    /// Baut die Logs-URL fuer den Stream-Selector <c>{key="value"}</c>, oder null,
    /// wenn der Schluessel im LogQL-Selector nicht adressierbar ist. <c>LogQl.ReadIdent</c>
    /// liest nur <c>[A-Za-z0-9_.]</c> — ein Schluessel mit anderen Zeichen (Klammern,
    /// Bindestrich, Leerzeichen) wuerde beim Parsen abbrechen und still einen falschen
    /// Filter ergeben. Dann lieber kein Link als ein Link, der etwas anderes sucht.
    /// </summary>
    private string? FilterUrl(string key, string value)
    {
        if (string.IsNullOrEmpty(key)) return null;
        foreach (var c in key)
            if (!char.IsLetterOrDigit(c) && c != '_' && c != '.') return null;

        // LogQl.ReadString kennt \\ und \" — in dieser Reihenfolge escapen.
        var v = (value ?? string.Empty).Replace("\\", "\\\\").Replace("\"", "\\\"");
        var q = "{" + key + "=\"" + v + "\"}";
        var url = BasePath + "/logs?q=" + Uri.EscapeDataString(q);
        return string.IsNullOrEmpty(ExtraQuery) ? url : url + "&" + ExtraQuery;
    }

    private string SevClass() => "hmd-sev-" + HeimdallFmt.Sev(Log.Severity).ToLowerInvariant();
}