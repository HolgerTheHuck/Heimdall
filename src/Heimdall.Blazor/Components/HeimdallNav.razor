@namespace Heimdall.Blazor
@* Navigationsleiste (sticky). BasePath ist das Praefix, unter dem das Dashboard haengt.
   Der aktive Tab wird ueber den Request-Pfad markiert (aria-current="page") — via
   HttpContext, das im statischen SSR als CascadingParameter verfuegbar ist. "@"
   rendert aria-current nur bei dem Tab, dessen Pfad zum aktuellen Request passt.
   Rechts: Flaggen-Schalter (de/en/fr) als kleine POST-Forms (CSRF-sicher via
   /lang-Endpoint + CheckSameOrigin); Windows rendert keine Emoji-Flaggen, daher
   inline SVG. Kein JS. *@
@inject Heimdall.Blazor.IHeimdallI18n I18n
<header class="hmd-nav">
    <a class="hmd-brand" href="@BasePath">@Heimdall.Blazor.HeimdallMark.Brand("hmd-bif-nav") Heimdall</a>
    <nav class="hmd-tabs" aria-label="@I18n.T("nav.aria.label")">
        <a href="@BasePath" aria-current="@Active("")">@I18n.T("nav.overview")</a>
        <a href="@(BasePath + "/dashboard")" aria-current="@Active("/dashboard")">@I18n.T("nav.monitoring")</a>
        <a href="@(BasePath + "/dashboards")" aria-current="@Active("/dashboards")">@I18n.T("nav.dashboards")</a>
        <a href="@(BasePath + "/endpoints")" aria-current="@Active("/endpoints")">@I18n.T("nav.endpoints")</a>
        <a href="@(BasePath + "/drilldown")" aria-current="@ActiveAny("/traces", "/logs", "/metrics")">@I18n.T("nav.drilldown")</a>
        <a href="@(BasePath + "/alerts")" aria-current="@Active("/alerts")">@I18n.T("nav.alerts")</a>
    </nav>
    <div class="hmd-lang" role="group" aria-label="@I18n.T("nav.flag.group")">
        @foreach (var l in Heimdall.Blazor.HeimdallI18n.Languages)
        {
            var isActive = I18n.Lang == l;
            var label = I18n.T("nav.flag." + l);
            <form method="post" action="@(BasePath + "/lang")" class="hmd-lang-form">
                <input type="hidden" name="set" value="@l" />
                <input type="hidden" name="ret" value="@CurrentUrl" />
                <button type="submit" class="hmd-lang-btn@(isActive ? " is-active" : "")"
                        lang="@l" aria-label="@label" title="@label"
                        aria-current="@(isActive ? "true" : null)">
                    @FlagSvg(l)
                </button>
            </form>
        }
    </div>
</header>

@code {
    [Parameter] public string BasePath { get; set; } = "/otel";

    // Statisches SSR: HttpContext als CascadingParameter; ohne Request (z. B.
    // reiner Unit-Render ohne HTTP-Kontext) null → keine Markierung (graceful).
    [Microsoft.AspNetCore.Components.CascadingParameter]
    public Microsoft.AspNetCore.Http.HttpContext? HttpContext { get; set; }

    private string? _path;
    private string _inAppBase = "/otel";

    protected override void OnInitialized()
    {
        _path = HttpContext?.Request.Path.Value ?? null;
        // BasePath trägt den externen Prefix (PathBase + Prefix, HeimdallUiPaths).
        // Der Request-Pfad ist in-app (ohne PathBase) — für die aktive-Markierung
        // und die Tab-Vergleiche deshalb den In-App-Anteil rekonstruieren.
        var pb = HttpContext?.Request.PathBase.Value ?? "";
        _inAppBase = pb.Length > 0 && BasePath.StartsWith(pb, StringComparison.Ordinal)
            ? BasePath[pb.Length..] : BasePath;
        if (_inAppBase.Length == 0) _inAppBase = "/";
    }

    /// <summary>Aktuelle Request-URL (PathBase + Pfad + Query) als Return-Ziel für /lang
    /// — extern auflösbar, damit der /lang-Redirect beim Deployment unter einem
    /// Pfad-Prefix nicht am Site-Root landet.</summary>
    private string CurrentUrl
        => (HttpContext is null
                ? BasePath
                : HttpContext.Request.PathBase.Value + HttpContext.Request.Path.Value)
           + (HttpContext?.Request.QueryString.Value ?? "");

    /// <summary>
    /// Liefert "page", wenn der Tab-Pfad der aktuelle Request-Pfad ist (Root-Tab:
    /// exakt BasePath; Unterseiten: StartsWith). Sonst null (kein aria-current).
    /// </summary>
    private string? Active(string tabSuffix)
    {
        if (string.IsNullOrEmpty(_path)) return null;
        var tabPath = _inAppBase + tabSuffix;
        if (tabSuffix.Length == 0)
            return _path == _inAppBase || _path == _inAppBase + "/" ? "page" : null;
        return _path.StartsWith(tabPath + "/", StringComparison.Ordinal) || _path == tabPath ? "page" : null;
    }

    /// <summary>Wie Active, markiert aber den Eltern-Tab, wenn EINER der
    /// Sub-Pfade aktiv ist (Drilldown-Gruppe: Traces/Logs/Metriken).</summary>
    private string? ActiveAny(params string[] tabSuffixes)
    {
        foreach (var s in tabSuffixes)
            if (Active(s) == "page") return "page";
        return null;
    }

    /// <summary>Inline-SVG-Flagge für die Sprache (Windows rendert keine Emoji-Flaggen).</summary>
    private Microsoft.AspNetCore.Components.MarkupString FlagSvg(string lang)
    {
        var svg = lang switch
        {
            "de" => """<svg viewBox="0 0 5 3" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" preserveAspectRatio="none"><rect width="5" height="1" fill="#000"/><rect y="1" width="5" height="1" fill="#D00"/><rect y="2" width="5" height="1" fill="#FFCE00"/></svg>""",
            "en" => """<svg viewBox="0 0 60 40" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" preserveAspectRatio="none"><rect width="60" height="40" fill="#012169"/><path d="M0,0 L60,40 M60,0 L0,40" stroke="#fff" stroke-width="8"/><path d="M0,0 L60,40 M60,0 L0,40" stroke="#C8102E" stroke-width="3"/><rect x="25" width="10" height="40" fill="#fff"/><rect y="15" width="60" height="10" fill="#fff"/><rect x="27" width="6" height="40" fill="#C8102E"/><rect y="17" width="60" height="6" fill="#C8102E"/></svg>""",
            "fr" => """<svg viewBox="0 0 3 2" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" preserveAspectRatio="none"><rect width="1" height="2" fill="#0055A4"/><rect x="1" width="1" height="2" fill="#fff"/><rect x="2" width="1" height="2" fill="#EF4135"/></svg>""",
            _ => "",
        };
        return new Microsoft.AspNetCore.Components.MarkupString(svg);
    }
}