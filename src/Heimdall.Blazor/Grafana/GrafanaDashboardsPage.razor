@* Liste der importierten Grafana-Dashboards. Jedes Dashboard ist ein Link zur
   View-Seite; ein Delete-Form (POST) entfernt es aus dem dateibasierten Store.
   Oben ein Link zur Import-Seite. Kein JS. *@
@using Heimdall.Blazor.Grafana
@inject IGrafanaDashboardStore Store
@inject Heimdall.Blazor.IHeimdallI18n I18n

<HeimdallDocument Title="@I18n.T("page.title.grafanaList")" BasePath="@BasePath">
    <h1>@I18n.T("page.title.grafanaList")</h1>
    <p class="hmd-dim">@I18n.T("grafana.list.subtitle")</p>
    <p>
        <a class="hmd-btn" href="@(BasePath + "/dashboards/import")">@I18n.T("grafana.list.import")</a>
        <a class="hmd-btn" href="@(BasePath + "/dashboards/new")">@I18n.T("grafana.edit.new")</a>
    </p>

    @if (_list.Count == 0)
    {
        <p class="hmd-empty" role="status">@I18n.T("grafana.list.empty")</p>
    }
    else
    {
        <table class="hmd-table">
            <caption>@I18n.T("page.title.grafanaList")</caption>
            <thead><tr><th scope="col">@I18n.T("grafana.list.col.title")</th><th scope="col">UID</th><th scope="col">@I18n.T("grafana.list.col.panels")</th><th scope="col"><span class="hmd-vh">@I18n.T("table.actions")</span></th></tr></thead>
            <tbody>
                @foreach (var d in _list)
                {
                    <tr>
                        <td><a href="@(BasePath + "/dashboards/" + d.Uid)">@d.Title</a></td>
                        <td class="hmd-mono">@d.Uid</td>
                        <td>@d.PanelCount</td>
                        <td>
                            <form method="post" action="@(BasePath + "/dashboards/" + d.Uid + "/delete")">
                                <button type="submit" class="hmd-btn hmd-btn-danger">@I18n.T("alert.detail.delete")</button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
</HeimdallDocument>

@code {
    [Parameter] public string BasePath { get; set; } = "/otel";
    private IReadOnlyList<GrafanaDashboardRef> _list = System.Array.Empty<GrafanaDashboardRef>();

    protected override void OnInitialized() => _list = Store.List();
}