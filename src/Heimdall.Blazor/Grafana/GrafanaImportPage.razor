@* Import-Seite: Grafana-Dashboard-JSON per Datei-Upload ODER Paste-Textarea
   hochladen (POST /dashboards/import). Nach dem Import Redirect zur View-Seite. *@
@inject IGrafanaDashboardStore Store
@inject Heimdall.Blazor.IHeimdallI18n I18n

<HeimdallDocument Title="@I18n.T("page.title.grafanaImport")" BasePath="@BasePath">
    <h1>@I18n.T("page.title.grafanaImport")</h1>
    <p class="hmd-dim">@I18n.T("grafana.import.subtitle")</p>

    <form class="hmd-filters" method="post" action="@(BasePath + "/dashboards/import")" enctype="multipart/form-data">
        <label>@I18n.T("grafana.import.file")
            <input type="file" name="file" accept="application/json,.json" />
        </label>
        <label style="flex-basis:100%">@I18n.T("grafana.import.json")
            <textarea name="json" rows="12" placeholder='{ "title": "...", "panels": [...] }'></textarea>
        </label>
        <button type="submit">@I18n.T("grafana.import.submit")</button>
        <a class="hmd-btn" href="@(BasePath + "/dashboards")">@I18n.T("alert.editor.cancel")</a>
    </form>

    @if (!string.IsNullOrEmpty(_error))
    {
        <p class="hmd-empty hmd-err-text" role="alert">@_error</p>
    }
</HeimdallDocument>

@code {
    [Parameter] public string BasePath { get; set; } = "/otel";
    [Parameter] public string? Error { get; set; }
    private string _error = string.Empty;
    protected override void OnParametersSet() => _error = Error ?? string.Empty;
}