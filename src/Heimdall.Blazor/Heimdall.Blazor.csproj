<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Heimdall.Blazor</RootNamespace>
    <AssemblyName>Heimdall.Blazor</AssemblyName>
    <IsPackable>true</IsPackable>
    <PackageId>Heimdall.Blazor</PackageId>
    <Description>Heimdall embedded observability UI: server-rendered Blazor dashboard (traces / logs / metrics) consuming IHeimdallQuery. No SignalR/JS required — static SSR, maximally embeddable.</Description>
    <PackageTags>otel;opentelemetry;telemetry;embedded;heimdall;blazor;ui</PackageTags>
    <Version>0.1.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Heimdall.Abstractions\Heimdall.Abstractions.csproj" />
    <ProjectReference Include="..\Heimdall.Prometheus\Heimdall.Prometheus.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Heimdall.Tests" />
  </ItemGroup>

</Project>