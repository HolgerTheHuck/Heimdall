@namespace Heimdall.Blazor
@* Controller/Endpoint-Drilldown (ASP.NET-WebAPI-Monitoring). Aggregiert die
   Server-Spans im Zeitfenster per HeimdallEndpointAgg (Load, avg/min/max,
   p50/p95/p99, Fehlerrate) auf drei Ebenen: Gesamt-API → Controller → Endpoint
   (Action). Dimensions-Attribute liefert das Heimdall.AspNetCore-Plugin
   (aspnetmvc.controller/action + http.route); fehlen sie, fällt die Aggregation
   auf Route-Parsen zurück. Zwei Modi über [Parameter] Controller: Overview
   (Controller==null) und Controller-Detail. Kein JS. *@
@using System
@using System.Globalization
@using System.Collections.Generic
@inject Heimdall.IHeimdallQuery Query
@inject Heimdall.Blazor.IHeimdallI18n I18n

<HeimdallDocument Title="@I18n.T("page.title.endpoints")" BasePath="@BasePath">
    <h1>@I18n.T("page.title.endpoints")</h1>
    @if (string.IsNullOrEmpty(Controller))
    {
        <p class="hmd-dim">@I18n.T("endpoint.subtitle", _rangeLabel, _spans.Count)</p>
    }
    else
    {
        <p class="hmd-dim"><a class="hmd-back" href="@(BasePath + "/endpoints")">@I18n.T("endpoint.back.all")</a> · @I18n.T("endpoint.controller.label", Controller) · @I18n.T("endpoint.spans.label", _focusStat.Count)</p>
    }

    <form class="hmd-filters" method="get" action="@_formAction">
        <label>@I18n.T("endpoint.filter.controllerattr") <input type="search" name="controllerAttr" value="@ControllerAttr" /></label>
        <label>@I18n.T("endpoint.filter.actionattr") <input type="search" name="actionAttr" value="@ActionAttr" /></label>
        <label>@I18n.T("endpoint.filter.routeattr") <input type="search" name="routeAttr" value="@RouteAttr" /></label>
        <label>@I18n.T("metrics.filter.limit") <input type="number" name="limit" value="@Limit" min="1" max="20000" /></label>
        <HeimdallTimeRange Preset="@Preset" From="@From" To="@To" />
        <button type="submit">@I18n.T("metrics.filter.load")</button>
    </form>

    @if (_hasData)
    {
        <div class="hmd-kpi-row">
            <HeimdallKpi Value="@(_focusStat.Count.ToString(CultureInfo.InvariantCulture))" Label="@I18n.T("endpoint.kpi.calls")" Sub="@I18n.T("dashboard.kpi.rate.sub", HeimdallCharting.FmtValue(_callsPerSec))" Tone="accent" ToneLabel="@ToneText("accent")" />
            <HeimdallKpi Value="@HeimdallFmt.Dur((long)_focusStat.AvgNs)" Label="@I18n.T("endpoint.kpi.avg.resp")" Sub="@I18n.T("endpoint.kpi.avg")" Tone="ok" ToneLabel="@ToneText("ok")" />
            <HeimdallKpi Value="@HeimdallFmt.Dur((long)_focusStat.MinNs)" Label="min" Sub="@I18n.T("dashboard.kpi.response")" Tone="ok" ToneLabel="@ToneText("ok")" />
            <HeimdallKpi Value="@HeimdallFmt.Dur((long)_focusStat.MaxNs)" Label="max" Sub="@I18n.T("dashboard.kpi.response")" Tone="@_maxTone" ToneLabel="@ToneText(_maxTone)" />
            <HeimdallKpi Value="@HeimdallFmt.Dur((long)_focusStat.P95)" Label="p95" Sub="@I18n.T("dashboard.kpi.response")" Tone="@_p95Tone" ToneLabel="@ToneText(_p95Tone)" />
            <HeimdallKpi Value="@_errPct" Label="@I18n.T("endpoint.kpi.errrate")" Sub="@I18n.T("endpoint.kpi.err.sub", _focusStat.Errors)" Tone="@_errTone" ToneLabel="@ToneText(_errTone)" />
        </div>

        @if (string.IsNullOrEmpty(Controller))
        {
            <h2 class="hmd-subhead">@I18n.T("endpoint.heading.controllers", _rollup.Controllers.Count)</h2>
            @if (_rollup.Controllers.Count == 0)
            {
                <p class="hmd-empty" role="status">@I18n.T("endpoint.empty.controllers")</p>
            }
            else
            {
                <table class="hmd-table">
                    <caption>@I18n.T("endpoint.col.controller")</caption>
                    <thead><tr><th scope="col">@I18n.T("endpoint.col.controller")</th><th scope="col">@I18n.T("endpoint.col.calls")</th><th scope="col">∅/s</th><th scope="col">avg</th><th scope="col">min</th><th scope="col">max</th><th scope="col">p95</th><th scope="col">@I18n.T("endpoint.col.err")</th><th scope="col"><span class="hmd-vh">@I18n.T("table.actions")</span></th></tr></thead>
                    <tbody>
                    @foreach (var c in _rollup.Controllers)
                    {
                        <tr>
                            <td><a href="@(BasePath + "/endpoints/" + Uri.EscapeDataString(c.Controller))">@c.Controller</a></td>
                            <td>@c.Count.ToString(CultureInfo.InvariantCulture)</td>
                            <td>@HeimdallCharting.FmtValue(RatePerSec(c.Count))</td>
                            <td>@HeimdallFmt.Dur((long)c.AvgNs)</td>
                            <td>@HeimdallFmt.Dur((long)c.MinNs)</td>
                            <td>@HeimdallFmt.Dur((long)c.MaxNs)</td>
                            <td>@HeimdallFmt.Dur((long)c.P95)</td>
                            <td>@ErrPct(c)</td>
                            <td><a href="@(BasePath + "/endpoints/" + Uri.EscapeDataString(c.Controller))" aria-label="@I18n.T("endpoint.action.open")">→</a></td>
                        </tr>
                    }
                    </tbody>
                </table>
            }
        }
        else
        {
            var eps = _controllerEndpoints;
            <h2 class="hmd-subhead">@I18n.T("endpoint.heading.endpoints", eps.Count)</h2>
            @if (eps.Count == 0)
            {
                <p class="hmd-empty" role="status">@I18n.T("endpoint.empty.endpoints", Controller)</p>
            }
            else
            {
                <table class="hmd-table">
                    <caption>@I18n.T("endpoint.heading.endpoints", eps.Count)</caption>
                    <thead><tr><th scope="col">Action</th><th scope="col">Route</th><th scope="col">@I18n.T("endpoint.col.calls")</th><th scope="col">avg</th><th scope="col">min</th><th scope="col">max</th><th scope="col">p50</th><th scope="col">p95</th><th scope="col">p99</th><th scope="col">@I18n.T("endpoint.col.err")</th><th scope="col"><span class="hmd-vh">@I18n.T("table.actions")</span></th></tr></thead>
                    <tbody>
                    @foreach (var e in eps)
                    {
                        <tr class="@(e.Errors > 0 ? "hmd-err" : "")">
                            <td>@e.Action</td>
                            <td class="hmd-mono">@(string.IsNullOrEmpty(e.Route) ? "—" : e.Route)</td>
                            <td>@e.Count.ToString(CultureInfo.InvariantCulture)</td>
                            <td>@HeimdallFmt.Dur((long)e.AvgNs)</td>
                            <td>@HeimdallFmt.Dur((long)e.MinNs)</td>
                            <td>@HeimdallFmt.Dur((long)e.MaxNs)</td>
                            <td>@HeimdallFmt.Dur((long)e.P50)</td>
                            <td>@HeimdallFmt.Dur((long)e.P95)</td>
                            <td>@HeimdallFmt.Dur((long)e.P99)</td>
                            <td>@ErrPct(e)</td>
                            <td><a href="@(BasePath + "/traces?name=" + Uri.EscapeDataString(string.IsNullOrEmpty(e.Route) ? e.Action : e.Route))">trace →</a></td>
                        </tr>
                    }
                    </tbody>
                </table>
            }
        }
    }
    else
    {
        <p class="hmd-empty" role="status">@I18n.T("endpoint.empty.nospans", Limit)</p>
    }
</HeimdallDocument>

@code {
    [Parameter] public string BasePath { get; set; } = "/otel";
    [Parameter] public string? Controller { get; set; }
    [Parameter] public string ControllerAttr { get; set; } = HeimdallEndpointAgg.DefaultControllerAttr;
    [Parameter] public string ActionAttr { get; set; } = HeimdallEndpointAgg.DefaultActionAttr;
    [Parameter] public string RouteAttr { get; set; } = HeimdallEndpointAgg.DefaultRouteAttr;
    [Parameter] public int Limit { get; set; } = 5000;
    [Parameter] public string? Preset { get; set; }
    [Parameter] public long? From { get; set; }
    [Parameter] public long? To { get; set; }

    private List<Heimdall.SpanRow> _spans = new();
    private EndpointRollup _rollup = new(new EndpointStat("", "", "", 0, 0, 0, 0, 0, 0, 0, 0),
        new List<EndpointStat>(), new Dictionary<string, IReadOnlyList<EndpointStat>>());
    private IReadOnlyList<EndpointStat> _controllerEndpoints = new List<EndpointStat>();
    private EndpointStat _focusStat = new("", "", "", 0, 0, 0, 0, 0, 0, 0, 0);
    private bool _hasData;
    private string _rangeLabel = "—";
    private string _formAction = "/otel/endpoints";
    private long _windowNs;
    private double _callsPerSec;

    private string _errPct = "0 %";
    private string _errTone = "ok";
    private string _p95Tone = "ok";
    private string _maxTone = "ok";

    /// <summary>Accessibler Tone-Text („Kritisch"/„Warnung"/„OK") für die KPI-Farb-Aussage.</summary>
    private string ToneText(string tone) => tone is "ok" or "warn" or "err" or "accent" ? I18n.T("kpi.tone." + tone) : "";

    protected override void OnInitialized()
    {
        int lim = Limit < 1 ? 5000 : (Limit > 20000 ? 20000 : Limit);
        var range = HeimdallRange.Resolve(Preset, From, To, HeimdallRange.NowUnixNano(), fallbackPreset: "24h");
        _rangeLabel = RangeLabel(Preset, From, To);
        _formAction = BasePath + (string.IsNullOrEmpty(Controller) ? "/endpoints" : "/endpoints/" + Uri.EscapeDataString(Controller));

        // Server-Spans im Zeitfenster (Kind=Server); Aggregation in der App.
        _spans = new List<Heimdall.SpanRow>(
            Query.ListSpans(new Heimdall.SpanFilter
            {
                FromUnixNano = range.From,
                ToUnixNano = range.To,
                Kind = (int)Heimdall.HSpanKind.Server,
                Limit = lim,
            }));
        _windowNs = (range.From is not null && range.To is not null) ? Math.Max(1, range.To.Value - range.From.Value) : 0;

        _rollup = HeimdallEndpointAgg.Aggregate(_spans, ControllerAttr, ActionAttr, RouteAttr);
        _hasData = _rollup.Overall.Count > 0;

        // Fokus-Stat: Overall im Overview-Modus, sonst der gewählte Controller.
        if (string.IsNullOrEmpty(Controller))
        {
            _focusStat = _rollup.Overall;
            _controllerEndpoints = new List<EndpointStat>();
        }
        else
        {
            _focusStat = new EndpointStat(Controller, "", "", 0, 0, 0, 0, 0, 0, 0, 0);
            foreach (var c in _rollup.Controllers)
                if (c.Controller == Controller) { _focusStat = c; break; }
            _rollup.EndpointsByController.TryGetValue(Controller, out var eps);
            _controllerEndpoints = eps ?? new List<EndpointStat>();
        }

        _callsPerSec = RatePerSec(_focusStat.Count);
        _errPct = ErrPct(_focusStat);
        // Tones: Fehler rot ab 5 %, gelb ab 1 %; p95 rot ab 1 s, gelb ab 200 ms; max rot ab 2 s, gelb ab 1 s.
        double er = _focusStat.Count > 0 ? (double)_focusStat.Errors / _focusStat.Count : 0;
        _errTone = er >= 0.05 ? "err" : er >= 0.01 ? "warn" : "ok";
        _p95Tone = _focusStat.P95 >= 1_000_000_000 ? "err" : _focusStat.P95 >= 200_000_000 ? "warn" : "ok";
        _maxTone = _focusStat.MaxNs >= 2_000_000_000 ? "err" : _focusStat.MaxNs >= 1_000_000_000 ? "warn" : "ok";
    }

    private double RatePerSec(long count) => _windowNs > 0 ? count / (_windowNs / 1_000_000_000.0) : 0;

    private static string ErrPct(EndpointStat s)
    {
        if (s.Count <= 0) return "0 %";
        double p = (double)s.Errors / s.Count * 100.0;
        return p.ToString("0.##", CultureInfo.InvariantCulture) + " %";
    }

    private static string RangeLabel(string? preset, long? from, long? to)
    {
        if (from is not null || to is not null)
            return $"von {(from?.ToString(CultureInfo.InvariantCulture) ?? "—")} bis {(to?.ToString(CultureInfo.InvariantCulture) ?? "—")} ns";
        var key = string.IsNullOrWhiteSpace(preset) ? "24h" : preset;
        var p = HeimdallRange.Presets.FirstOrDefault(x => x.Key == key);
        return p?.Label ?? key;
    }
}