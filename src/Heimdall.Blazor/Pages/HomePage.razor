@namespace Heimdall.Blazor
@* Landing / Übersicht: orientierender Schnappschuss ohne Filter-Form. Health-KPIs
   (Spans/Logs/Metriken gesamt), letzte Fehler-Traces + Fehler-Logs (jeweils 5),
   Quick-Nav-Kacheln zu den Detailseiten. Bei komplett leerer DB ein geführtes
   Onboarding-Panel mit dem OTLP-Endpunkt. Pure C#-Aggregation auf IHeimdallQuery. *@
@using System.Collections.Generic
@inject Heimdall.IHeimdallQuery Query
@inject Heimdall.Blazor.IHeimdallI18n I18n

<HeimdallDocument Title="@I18n.T("page.title.home")" BasePath="@BasePath">
    <div class="hmd-page-head">
        <h1>@I18n.T("page.title.home")</h1>
        <span class="hmd-dim">@I18n.T("home.subtitle")</span>
    </div>

    @if (_isEmpty)
    {
        <section class="hmd-empty-state" role="status">
            <h2>@I18n.T("home.empty.title")</h2>
            <p>@I18n.T("home.empty.body")</p>
            <ul class="hmd-mono">
                <li>OTLP/HTTP:  <code>POST @BasePath/v1/traces</code> · <code>@BasePath/v1/metrics</code> · <code>@BasePath/v1/logs</code></li>
                <li>OTLP/gRPC:  <code>localhost:4317</code> (TraceService / LogsService / MetricsService.Export)</li>
            </ul>
            <p class="hmd-dim">@I18n.T("home.empty.sample") <code>OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:5099@BasePath</code></p>
        </section>
    }
    else
    {
        @* Wachtband-Hero: drei Sparkline-Lanes (Spans/Logs/Metrik-Punkte) über
           einem festen 1-Stunden-Fenster mit Minuten-Buckets. Kein Filter-Form —
           die echte Zeitauswahl leben die Drilldown-Seiten; hier geht es um den
           Momentaneindruck. Werte im Meta-Block (letzter Bucket + ∅/s über das
           Fenster) sind ohne JS vollständig; Hover-Layer ist Progressive
           Enhancement (heimdall.js). *@
        <section class="hmd-band" aria-label="@I18n.T("home.band.t")">
            <div class="hmd-band-head"><span class="hmd-band-title">@I18n.T("home.band.t")</span></div>
            <div class="hmd-band-lane hmd-band-lane--spans">
                <div class="hmd-band-meta">
                    <span class="hmd-band-name">@I18n.T("home.kpi.spans")</span>
                    <span class="hmd-band-val">@_bandSpans!.Last</span>
                    <span class="hmd-band-sub">@_bandSpans.RateSub</span>
                </div>
                <div class="hmd-band-chart" data-hmd-band="1" data-lbl="@I18n.T("home.kpi.spans")"
                     data-ago="@I18n.T("home.band.tip.ago")" data-max="@_bandSpans.Max" data-vals="@_bandSpans.Vals">
                    @(new Microsoft.AspNetCore.Components.MarkupString(_bandSpans.Svg))
                </div>
            </div>
            <div class="hmd-band-lane hmd-band-lane--logs">
                <div class="hmd-band-meta">
                    <span class="hmd-band-name">@I18n.T("home.kpi.logs")</span>
                    <span class="hmd-band-val">@_bandLogs!.Last</span>
                    <span class="hmd-band-sub">@_bandLogs.RateSub</span>
                </div>
                <div class="hmd-band-chart" data-hmd-band="1" data-lbl="@I18n.T("home.kpi.logs")"
                     data-ago="@I18n.T("home.band.tip.ago")" data-max="@_bandLogs.Max" data-vals="@_bandLogs.Vals">
                    @(new Microsoft.AspNetCore.Components.MarkupString(_bandLogs.Svg))
                </div>
            </div>
            <div class="hmd-band-lane hmd-band-lane--metrics">
                <div class="hmd-band-meta">
                    <span class="hmd-band-name">@I18n.T("home.kpi.metrics")</span>
                    <span class="hmd-band-val">@_bandMetrics!.Last</span>
                    <span class="hmd-band-sub">@_bandMetrics.RateSub</span>
                </div>
                <div class="hmd-band-chart" data-hmd-band="1" data-lbl="@I18n.T("home.kpi.metrics")"
                     data-ago="@I18n.T("home.band.tip.ago")" data-max="@_bandMetrics.Max" data-vals="@_bandMetrics.Vals">
                    @(new Microsoft.AspNetCore.Components.MarkupString(_bandMetrics.Svg))
                </div>
            </div>
            <div class="hmd-band-axis hmd-mono">
                <span>@I18n.T("home.band.axis.from")</span>
                <span>@I18n.T("home.band.axis.mid")</span>
                <span>@I18n.T("home.band.axis.now")</span>
            </div>
        </section>

        <div class="hmd-kpi-row">
            <HeimdallKpi Value="@_spansStr" Label="@I18n.T("home.kpi.spans")" Sub="@I18n.T("kpi.sub.total")" Tone="accent" ToneLabel="@I18n.T("kpi.tone.accent")" />
            <HeimdallKpi Value="@_logsStr" Label="@I18n.T("home.kpi.logs")" Sub="@I18n.T("kpi.sub.total")" Tone="ok" ToneLabel="@I18n.T("kpi.tone.ok")" />
            <HeimdallKpi Value="@_metricsStr" Label="@I18n.T("home.kpi.metrics")" Sub="@I18n.T("kpi.sub.total")" Tone="warn" ToneLabel="@I18n.T("kpi.tone.warn")" />
            <HeimdallKpi Value="@_errTracesStr" Label="@I18n.T("home.kpi.errtraces")" Sub="@I18n.T("kpi.sub.latest", _errTraces.Count)" Tone="@(_errTraces.Count > 0 ? "err" : "ok")" ToneLabel="@I18n.T(_errTraces.Count > 0 ? "kpi.tone.err" : "kpi.tone.ok")" />
        </div>

        <div class="hmd-navcards">
            <a class="hmd-navcard" href="@(BasePath + "/dashboard")"><span class="hmd-navcard-ico" aria-hidden="true">@Heimdall.Blazor.HeimdallMark.Navcard("dashboard")</span><span class="hmd-navcard-t">@I18n.T("navcard.dashboard.t")</span><span class="hmd-navcard-s">@I18n.T("navcard.dashboard.sub")</span></a>
            <a class="hmd-navcard" href="@(BasePath + "/traces")"><span class="hmd-navcard-ico" aria-hidden="true">@Heimdall.Blazor.HeimdallMark.Navcard("traces")</span><span class="hmd-navcard-t">@I18n.T("navcard.traces.t")</span><span class="hmd-navcard-s">@I18n.T("navcard.traces.sub")</span></a>
            <a class="hmd-navcard" href="@(BasePath + "/logs")"><span class="hmd-navcard-ico" aria-hidden="true">@Heimdall.Blazor.HeimdallMark.Navcard("logs")</span><span class="hmd-navcard-t">@I18n.T("navcard.logs.t")</span><span class="hmd-navcard-s">@I18n.T("navcard.logs.sub")</span></a>
            <a class="hmd-navcard" href="@(BasePath + "/metrics")"><span class="hmd-navcard-ico" aria-hidden="true">@Heimdall.Blazor.HeimdallMark.Navcard("metrics")</span><span class="hmd-navcard-t">@I18n.T("navcard.metrics.t")</span><span class="hmd-navcard-s">@I18n.T("navcard.metrics.sub")</span></a>
            <a class="hmd-navcard" href="@(BasePath + "/endpoints")"><span class="hmd-navcard-ico" aria-hidden="true">@Heimdall.Blazor.HeimdallMark.Navcard("endpoints")</span><span class="hmd-navcard-t">@I18n.T("navcard.endpoints.t")</span><span class="hmd-navcard-s">@I18n.T("navcard.endpoints.sub")</span></a>
            <a class="hmd-navcard" href="@(BasePath + "/dashboards")"><span class="hmd-navcard-ico" aria-hidden="true">@Heimdall.Blazor.HeimdallMark.Navcard("dashboards")</span><span class="hmd-navcard-t">@I18n.T("navcard.dashboards.t")</span><span class="hmd-navcard-s">@I18n.T("navcard.dashboards.sub")</span></a>
        </div>

        <div class="hmd-panels">
            <section class="hmd-panel">
                <h2 class="hmd-subhead">@I18n.T("home.section.errtraces") (@_errTraces.Count)</h2>
                @if (_errTraces.Count == 0)
                {
                    <p class="hmd-empty" role="status">@I18n.T("empty.noErrTraces")</p>
                }
                else
                {
                    <table class="hmd-table hmd-dense">
                        <caption>@I18n.T("home.section.errtraces")</caption>
                        <thead><tr><th scope="col">@I18n.T("table.trace.id")</th><th scope="col">@I18n.T("table.start")</th><th scope="col">@I18n.T("table.duration")</th><th scope="col">@I18n.T("table.spans")</th></tr></thead>
                        <tbody>
                        @foreach (var t in _errTraces)
                        {
                            <tr class="hmd-err">
                                <td class="hmd-mono"><a href="@(BasePath + "/trace/" + t.TraceId)">@HeimdallFmt.Truncate(t.TraceId, 16)</a></td>
                                <td>@HeimdallFmt.Ts(t.FirstStartUnixNano)</td>
                                <td>@HeimdallFmt.Dur(t.DurationNs)</td>
                                <td>@t.SpanCount</td>
                            </tr>
                        }
                        </tbody>
                    </table>
                }
            </section>
            <section class="hmd-panel">
                <h2 class="hmd-subhead">@I18n.T("home.section.errlogs") (@_errLogs.Count)</h2>
                @if (_errLogs.Count == 0)
                {
                    <p class="hmd-empty" role="status">@I18n.T("empty.noErrLogs")</p>
                }
                else
                {
                    <table class="hmd-table hmd-logs">
                        <caption>@I18n.T("home.section.errlogs")</caption>
                        <thead><tr><th class="hmd-col-ts" scope="col">@I18n.T("table.time")</th><th class="hmd-col-sev" scope="col">@I18n.T("table.sev")</th><th scope="col">@I18n.T("table.body")</th><th class="hmd-col-trace" scope="col">@I18n.T("table.trace")</th></tr></thead>
                        <tbody>
                        @foreach (var l in _errLogs)
                        {
                            <HeimdallLogRow Log="@l" BasePath="@BasePath" Expand="@false" />
                        }
                        </tbody>
                    </table>
                }
            </section>
        </div>
    }
</HeimdallDocument>

@code {
    [Parameter] public string BasePath { get; set; } = "/otel";

    /// <summary>Eine Wachtband-Lane, fertig fürs Markup: SVG (Linie/Fläche/
    /// Endpunkt-Dot), anzeigefertiger letzter Bucket-Wert, ∅/s-Sub über das
    /// Fenster, sowie die Rohdaten für den Hover-Layer (data-vals/data-max).</summary>
    private sealed record BandLane(string Svg, string Last, string RateSub, string Max, string Vals);

    private long _spans, _logs, _metrics;
    private List<Heimdall.TraceSummary> _errTraces = new();
    private List<Heimdall.LogRow> _errLogs = new();
    private bool _isEmpty;
    private BandLane? _bandSpans, _bandLogs, _bandMetrics;

    private string _spansStr = "0", _logsStr = "0", _metricsStr = "0", _errTracesStr = "0";

    protected override void OnInitialized()
    {
        _spans = Query.CountSpans();
        _logs = Query.CountLogs();
        _metrics = Query.CountMetrics();
        _isEmpty = _spans == 0 && _logs == 0 && _metrics == 0;

        _spansStr = HeimdallCharting.FmtValue(_spans);
        _logsStr = HeimdallCharting.FmtValue(_logs);
        _metricsStr = HeimdallCharting.FmtValue(_metrics);

        if (!_isEmpty)
        {
            // Wachtband: festes 1h-Fenster, Minuten-Buckets, 60 Slots — Slot 59
            // ist die laufende Minute. Sparse-Ergebnis (nur Buckets mit
            // Vorkommen) wird hier mit 0 aufgefüllt; die Skala bleibt absolut.
            var to = HeimdallRange.NowUnixNano();
            var from = to - HeimdallRange.NanosPerHour;
            var vol = Query.ListSignalVolume(from, to, HeimdallRange.NanosPerMinute);
            var spans = new long[60];
            var logs = new long[60];
            var mets = new long[60];
            var endMinute = to / HeimdallRange.NanosPerMinute;
            foreach (var p in vol)
            {
                var idx = (int)(p.BucketUnixNano / HeimdallRange.NanosPerMinute - (endMinute - 59));
                if (idx >= 0 && idx < 60)
                {
                    spans[idx] = p.Spans;
                    logs[idx] = p.Logs;
                    mets[idx] = p.Metrics;
                }
            }
            _bandSpans = BuildLane(spans);
            _bandLogs = BuildLane(logs);
            _bandMetrics = BuildLane(mets);

            _errTraces = new List<Heimdall.TraceSummary>(Query.ListTraces(new Heimdall.TraceFilter
            {
                HasError = true, Limit = 5,
            }));
            _errLogs = new List<Heimdall.LogRow>(Query.SearchLogs(new Heimdall.LogSearch
            {
                MinSeverity = 17, Limit = 5,
            }));
            _errTracesStr = HeimdallCharting.FmtValue(_errTraces.Count);
        }
    }

    /// <summary>Baut eine Lane aus den 60 Minuten-Zählern: SVG via
    /// <see cref="HeimdallCharting.RenderBandLaneSvg"/>, Anzeige-Wert = letzter
    /// Bucket, Sub = ∅/s über das Fenster (Summe / 3600). data-vals/data-max
    /// speisen den JS-Hover-Layer (max ≥ 1, damit die Punkt-Höhe stimmt).</summary>
    private BandLane BuildLane(long[] vals)
    {
        long max = 0, total = 0;
        foreach (var v in vals) { if (v > max) max = v; total += v; }
        var pts = new (long Tms, double V)[vals.Length];
        for (int i = 0; i < vals.Length; i++) pts[i] = (i, vals[i]);
        var inv = System.Globalization.CultureInfo.InvariantCulture;
        return new BandLane(
            HeimdallCharting.RenderBandLaneSvg(pts),
            HeimdallCharting.FmtValue(vals[^1]),
            I18n.T("dashboard.kpi.rate.sub", HeimdallCharting.FmtValue(total / 3600.0)),
            Math.Max(1L, max).ToString(inv),
            string.Join(",", vals));
    }
}