@namespace Heimdall.Blazor
@* Landing / Übersicht: orientierender Schnappschuss ohne Filter-Form. Health-KPIs
   (Spans/Logs/Metriken gesamt), letzte Fehler-Traces + Fehler-Logs (jeweils 5),
   Quick-Nav-Kacheln zu den Detailseiten. Bei komplett leerer DB ein geführtes
   Onboarding-Panel mit dem OTLP-Endpunkt. Pure C#-Aggregation auf IHeimdallQuery. *@
@using System.Collections.Generic
@inject Heimdall.IHeimdallQuery Query
@inject Heimdall.Blazor.IHeimdallI18n I18n

<HeimdallDocument Title="@I18n.T("page.title.home")" BasePath="@BasePath">
    <div class="hmd-page-head">
        <h1>@I18n.T("page.title.home")</h1>
        <span class="hmd-dim">@I18n.T("home.subtitle")</span>
    </div>

    @if (_isEmpty)
    {
        <section class="hmd-empty-state" role="status">
            <h2>@I18n.T("home.empty.title")</h2>
            <p>@I18n.T("home.empty.body")</p>
            <ul class="hmd-mono">
                <li>OTLP/HTTP:  <code>POST @BasePath/v1/traces</code> · <code>@BasePath/v1/metrics</code> · <code>@BasePath/v1/logs</code></li>
                <li>OTLP/gRPC:  <code>localhost:4317</code> (TraceService / LogsService / MetricsService.Export)</li>
            </ul>
            <p class="hmd-dim">@I18n.T("home.empty.sample") <code>OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:5099@BasePath</code></p>
        </section>
    }
    else
    {
        <div class="hmd-kpi-row">
            <HeimdallKpi Value="@_spansStr" Label="@I18n.T("home.kpi.spans")" Sub="@I18n.T("kpi.sub.total")" Tone="accent" ToneLabel="@I18n.T("kpi.tone.accent")" />
            <HeimdallKpi Value="@_logsStr" Label="@I18n.T("home.kpi.logs")" Sub="@I18n.T("kpi.sub.total")" Tone="ok" ToneLabel="@I18n.T("kpi.tone.ok")" />
            <HeimdallKpi Value="@_metricsStr" Label="@I18n.T("home.kpi.metrics")" Sub="@I18n.T("kpi.sub.total")" Tone="warn" ToneLabel="@I18n.T("kpi.tone.warn")" />
            <HeimdallKpi Value="@_errTracesStr" Label="@I18n.T("home.kpi.errtraces")" Sub="@I18n.T("kpi.sub.latest", _errTraces.Count)" Tone="@(_errTraces.Count > 0 ? "err" : "ok")" ToneLabel="@I18n.T(_errTraces.Count > 0 ? "kpi.tone.err" : "kpi.tone.ok")" />
        </div>

        <div class="hmd-navcards">
            <a class="hmd-navcard" href="@(BasePath + "/dashboard")"><span class="hmd-navcard-ico" aria-hidden="true">📊</span><span class="hmd-navcard-t">@I18n.T("navcard.dashboard.t")</span><span class="hmd-navcard-s">@I18n.T("navcard.dashboard.sub")</span></a>
            <a class="hmd-navcard" href="@(BasePath + "/traces")"><span class="hmd-navcard-ico" aria-hidden="true">⛓</span><span class="hmd-navcard-t">@I18n.T("navcard.traces.t")</span><span class="hmd-navcard-s">@I18n.T("navcard.traces.sub")</span></a>
            <a class="hmd-navcard" href="@(BasePath + "/logs")"><span class="hmd-navcard-ico" aria-hidden="true">📜</span><span class="hmd-navcard-t">@I18n.T("navcard.logs.t")</span><span class="hmd-navcard-s">@I18n.T("navcard.logs.sub")</span></a>
            <a class="hmd-navcard" href="@(BasePath + "/metrics")"><span class="hmd-navcard-ico" aria-hidden="true">📈</span><span class="hmd-navcard-t">@I18n.T("navcard.metrics.t")</span><span class="hmd-navcard-s">@I18n.T("navcard.metrics.sub")</span></a>
            <a class="hmd-navcard" href="@(BasePath + "/endpoints")"><span class="hmd-navcard-ico" aria-hidden="true">🛣</span><span class="hmd-navcard-t">@I18n.T("navcard.endpoints.t")</span><span class="hmd-navcard-s">@I18n.T("navcard.endpoints.sub")</span></a>
            <a class="hmd-navcard" href="@(BasePath + "/dashboards")"><span class="hmd-navcard-ico" aria-hidden="true">🗃</span><span class="hmd-navcard-t">@I18n.T("navcard.dashboards.t")</span><span class="hmd-navcard-s">@I18n.T("navcard.dashboards.sub")</span></a>
        </div>

        <div class="hmd-panels">
            <section class="hmd-panel">
                <h2 class="hmd-subhead">@I18n.T("home.section.errtraces") (@_errTraces.Count)</h2>
                @if (_errTraces.Count == 0)
                {
                    <p class="hmd-empty" role="status">@I18n.T("empty.noErrTraces")</p>
                }
                else
                {
                    <table class="hmd-table hmd-dense">
                        <caption>@I18n.T("home.section.errtraces")</caption>
                        <thead><tr><th scope="col">@I18n.T("table.trace.id")</th><th scope="col">@I18n.T("table.start")</th><th scope="col">@I18n.T("table.duration")</th><th scope="col">@I18n.T("table.spans")</th></tr></thead>
                        <tbody>
                        @foreach (var t in _errTraces)
                        {
                            <tr class="hmd-err">
                                <td class="hmd-mono"><a href="@(BasePath + "/trace/" + t.TraceId)">@HeimdallFmt.Truncate(t.TraceId, 16)</a></td>
                                <td>@HeimdallFmt.Ts(t.FirstStartUnixNano)</td>
                                <td>@HeimdallFmt.Dur(t.DurationNs)</td>
                                <td>@t.SpanCount</td>
                            </tr>
                        }
                        </tbody>
                    </table>
                }
            </section>
            <section class="hmd-panel">
                <h2 class="hmd-subhead">@I18n.T("home.section.errlogs") (@_errLogs.Count)</h2>
                @if (_errLogs.Count == 0)
                {
                    <p class="hmd-empty" role="status">@I18n.T("empty.noErrLogs")</p>
                }
                else
                {
                    <table class="hmd-table hmd-logs">
                        <caption>@I18n.T("home.section.errlogs")</caption>
                        <thead><tr><th class="hmd-col-ts" scope="col">@I18n.T("table.time")</th><th class="hmd-col-sev" scope="col">@I18n.T("table.sev")</th><th scope="col">@I18n.T("table.body")</th><th class="hmd-col-trace" scope="col">@I18n.T("table.trace")</th></tr></thead>
                        <tbody>
                        @foreach (var l in _errLogs)
                        {
                            <HeimdallLogRow Log="@l" BasePath="@BasePath" Expand="@false" />
                        }
                        </tbody>
                    </table>
                }
            </section>
        </div>
    }
</HeimdallDocument>

@code {
    [Parameter] public string BasePath { get; set; } = "/otel";

    private long _spans, _logs, _metrics;
    private List<Heimdall.TraceSummary> _errTraces = new();
    private List<Heimdall.LogRow> _errLogs = new();
    private bool _isEmpty;

    private string _spansStr = "0", _logsStr = "0", _metricsStr = "0", _errTracesStr = "0";

    protected override void OnInitialized()
    {
        _spans = Query.CountSpans();
        _logs = Query.CountLogs();
        _metrics = Query.CountMetrics();
        _isEmpty = _spans == 0 && _logs == 0 && _metrics == 0;

        _spansStr = HeimdallCharting.FmtValue(_spans);
        _logsStr = HeimdallCharting.FmtValue(_logs);
        _metricsStr = HeimdallCharting.FmtValue(_metrics);

        if (!_isEmpty)
        {
            _errTraces = new List<Heimdall.TraceSummary>(Query.ListTraces(new Heimdall.TraceFilter
            {
                HasError = true, Limit = 5,
            }));
            _errLogs = new List<Heimdall.LogRow>(Query.SearchLogs(new Heimdall.LogSearch
            {
                MinSeverity = 17, Limit = 5,
            }));
            _errTracesStr = HeimdallCharting.FmtValue(_errTraces.Count);
        }
    }
}