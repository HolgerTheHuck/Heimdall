@namespace Heimdall.Blazor
@* Metriken: Serie zu einem Namen, gruppiert nach Attribut-Dimension → SVG-Liniendiagramm
   (Gauge/Sum) bzw. Linie + Histogramm-Balken (Histogram). Kein JS. *@
@using System.Collections.Generic
@using System.Globalization
@inject Heimdall.IHeimdallQuery Query
@inject Heimdall.Blazor.IHeimdallI18n I18n

<HeimdallDocument Title="@I18n.T("page.title.metrics")" BasePath="@BasePath">
    <h1>@I18n.T("page.title.metrics")</h1>

    <form class="hmd-filters" method="get" action="@(BasePath + "/metrics")">
        <label>@I18n.T("metrics.filter.name") <input type="search" name="name" value="@Name" placeholder="http.server.request.duration" /></label>
        <label>@I18n.T("metrics.filter.limit") <input type="number" name="limit" value="@Limit" min="1" max="5000" /></label>
        <HeimdallTimeRange Preset="@Preset" From="@From" To="@To" />
        <button type="submit">@I18n.T("metrics.filter.load")</button>
    </form>

    @if (string.IsNullOrWhiteSpace(Name))
    {
        <h2 class="hmd-subhead">@I18n.T("metrics.available.title")</h2>
        @if (_availableNames.Count == 0)
        {
            <section class="hmd-empty-state" role="status">
                <h2>@I18n.T("metrics.empty.title")</h2>
                <p>@I18n.T("metrics.empty.body")</p>
                <p class="hmd-dim">@I18n.T("traces.empty.hint.http") <code>POST @BasePath/v1/metrics</code> · @I18n.T("traces.empty.hint.grpc") <code>localhost:4317</code> · @I18n.T("common.back.to") <a href="@BasePath">@I18n.T("nav.overview")</a></p>
            </section>
        }
        else
        {
            <p class="hmd-dim">@I18n.T("metrics.available.hint", Query.CountMetrics())</p>
            <ul class="hmd-metric-list">
            @foreach (var n in _availableNames)
            {
                <li><a href="@(BasePath + "/metrics?" + RangeQuery(n))" class="hmd-mono">@n</a></li>
            }
            </ul>
        }
    }
    else if (_series.Count == 0)
    {
        <section class="hmd-empty-state" role="status">
            <h2>@I18n.T("metrics.empty.series.title", Name)</h2>
            <p>@I18n.T("metrics.empty.series.body")</p>
            <p class="hmd-dim">@I18n.T("traces.empty.hint.http") <code>POST @BasePath/v1/metrics</code> · @I18n.T("traces.empty.hint.grpc") <code>localhost:4317</code> · @I18n.T("common.back.to") <a href="@BasePath">@I18n.T("nav.overview")</a></p>
        </section>
    }
    else
    {
        <h2 class="hmd-subhead">
            @Name · @((Heimdall.HMetricType)_type) · @((Heimdall.HTemporality)_temp)
            @if (!string.IsNullOrEmpty(_unit)) { <span class="hmd-dim">· @I18n.T("metrics.unit") @_unit</span> }
        </h2>

        <HeimdallChart Series="@_chartSeries" Unit="@_unit" AriaLabel="@I18n.T("chart.aria.metric", Name)" Height="240" />

        @if (_truncated)
        {
            <p class="hmd-count">@I18n.T("metrics.truncated.body", _series.Count, _pageSize) <a class="hmd-btn" href="@MoreUrl()">@I18n.T("metrics.truncated.more", _nextLimit)</a></p>
        }

        @if (_histCounts.Count > 0)
        {
            <h3 class="hmd-subhead-sm">@I18n.T("metrics.distribution.title")</h3>
            <HeimdallHistogram BucketCounts="@_histCounts" ExplicitBounds="@_histBounds" Unit="@_unit" AriaLabel="@I18n.T("chart.hist.aria")" />
        }

        <details class="hmd-raw">
            <summary>@I18n.T("metrics.raw.summary", _series.Count)</summary>
            <table class="hmd-table">
                <caption>@I18n.T("metrics.raw.caption")</caption>
                <thead><tr><th scope="col">@I18n.T("table.time")</th><th scope="col">@I18n.T("metrics.col.type")</th><th scope="col">@I18n.T("metrics.col.value")</th><th scope="col">@I18n.T("metrics.col.count")</th><th scope="col">@I18n.T("metrics.col.sum")</th><th scope="col">Min</th><th scope="col">Max</th><th scope="col">@I18n.T("metrics.col.attrs")</th></tr></thead>
                <tbody>
                @foreach (var m in _series)
                {
                    <tr>
                        <td class="hmd-mono">@HeimdallFmt.Ts(m.TimeUnixNano)</td>
                        <td>@((Heimdall.HMetricType)m.Type)</td>
                        <td>@m.Value.ToString(CultureInfo.InvariantCulture)</td>
                        <td>@(m.Count?.ToString(CultureInfo.InvariantCulture) ?? "—")</td>
                        <td>@(m.Sum?.ToString("0.##", CultureInfo.InvariantCulture) ?? "—")</td>
                        <td>@(m.Min?.ToString("0.##", CultureInfo.InvariantCulture) ?? "—")</td>
                        <td>@(m.Max?.ToString("0.##", CultureInfo.InvariantCulture) ?? "—")</td>
                        <td class="hmd-json">@HeimdallFmt.Truncate(m.AttrsJson, 60)</td>
                    </tr>
                }
                </tbody>
            </table>
        </details>
    }
    <p class="hmd-count">@I18n.T("metrics.count.bottom", _series.Count, Query.CountMetrics())</p>
</HeimdallDocument>

@code {
    [Parameter] public string BasePath { get; set; } = "/otel";
    [Parameter] public string? Name { get; set; }
    [Parameter] public int Limit { get; set; } = 500;
    [Parameter] public string? Preset { get; set; }
    [Parameter] public long? From { get; set; }
    [Parameter] public long? To { get; set; }

    private List<Heimdall.MetricRow> _series = new();
    private List<ChartSeries> _chartSeries = new();
    private List<long> _histCounts = new();
    private List<double> _histBounds = new();
    private List<string> _availableNames = new();
    private int _type;
    private int _temp;
    private string? _unit;
    private int _pageSize;
    private int _nextLimit;
    private bool _truncated;

    protected override void OnInitialized()
    {
        var range = HeimdallRange.Resolve(Preset, From, To, HeimdallRange.NowUnixNano());

        // Ohne Namen: Discovery-Modus — verfügbare Metrik-Namen im Zeitraum auflisten.
        if (string.IsNullOrWhiteSpace(Name))
        {
            _availableNames = new List<string>(Query.ListMetricNames(range.From, range.To));
            return;
        }

        _pageSize = Limit < 1 ? 500 : Limit;
        if (_pageSize > 5000) _pageSize = 5000;
        _series = new List<Heimdall.MetricRow>(
            Query.MetricSeries(Name, range.From, range.To, _pageSize));
        if (_series.Count == 0) return;

        // Serie am Limit → wahrscheinlich mehr Punkte im Zeitraum. „mehr anzeigen"
        // verdoppelt das Limit (max 5000), da Metriken eine Zeitreihe sind und echtes
        // Paging (Offset) hier nicht greift (Chart braucht das ganze Fenster).
        _truncated = _series.Count >= _pageSize && _pageSize < 5000;
        _nextLimit = Math.Min(_pageSize * 2, 5000);

        _type = _series[0].Type;
        _temp = _series[0].Temporality;
        _unit = _series[0].Unit;

        // Nach Attribut-Fingerprint gruppieren → eine Linie pro Dimension.
        var groups = new Dictionary<string, List<(long T, double V)>>();
        var labels = new Dictionary<string, string>();
        var order = new List<string>();
        foreach (var m in _series)
        {
            if (!groups.TryGetValue(m.AttrsJson, out var pts))
            {
                pts = new List<(long, double)>();
                groups[m.AttrsJson] = pts;
                labels[m.AttrsJson] = HeimdallCharting.FormatAttrsLabel(HeimdallCharting.ParseAttrs(m.AttrsJson));
                order.Add(m.AttrsJson);
            }
            pts.Add((m.TimeUnixNano, m.Value));
        }
        _chartSeries.Clear();
        for (int i = 0; i < order.Count; i++)
        {
            var key = order[i];
            var pts = groups[key];
            pts.Sort((a, b) => a.T.CompareTo(b.T));
            _chartSeries.Add(new ChartSeries(labels[key], HeimdallCharting.ColorAt(i), pts));
        }

        // Histogramm: Bucket-Verteilung des neuesten Punkts.
        if ((Heimdall.HMetricType)_type == Heimdall.HMetricType.Histogram)
        {
            Heimdall.MetricRow? last = null;
            foreach (var m in _series)
                if (last is null || m.TimeUnixNano > last.TimeUnixNano) last = m;
            if (last is not null)
            {
                _histCounts = new List<long>(HeimdallCharting.ParseLongs(last.BucketCountsJson));
                _histBounds = new List<double>(HeimdallCharting.ParseDoubles(last.ExplicitBoundsJson));
            }
        }
    }

    /// <summary>Baut den Query-Suffix für einen Metrik-Namen-Link (erhält den Zeitraum).</summary>
    private string RangeQuery(string name)
    {
        var s = "name=" + System.Uri.EscapeDataString(name);
        if (!string.IsNullOrEmpty(Preset)) s += "&preset=" + System.Uri.EscapeDataString(Preset);
        else
        {
            if (From is not null) s += "&from=" + From.Value.ToString(CultureInfo.InvariantCulture);
            if (To is not null) s += "&to=" + To.Value.ToString(CultureInfo.InvariantCulture);
        }
        return s;
    }

    /// <summary>URL zum Laden weiterer Punkte (Limit verdoppeln, max 5000).</summary>
    private string MoreUrl()
    {
        var s = "name=" + System.Uri.EscapeDataString(Name ?? "") + "&limit=" + _nextLimit.ToString(CultureInfo.InvariantCulture);
        if (!string.IsNullOrEmpty(Preset)) s += "&preset=" + System.Uri.EscapeDataString(Preset);
        else
        {
            if (From is not null) s += "&from=" + From.Value.ToString(CultureInfo.InvariantCulture);
            if (To is not null) s += "&to=" + To.Value.ToString(CultureInfo.InvariantCulture);
        }
        return BasePath + "/metrics?" + s;
    }
}