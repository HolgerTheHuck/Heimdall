<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>
    <ImplicitUsings>disable</ImplicitUsings>
    <RootNamespace>Heimdall.Direct</RootNamespace>
    <AssemblyName>Heimdall.Direct</AssemblyName>
    <IsPackable>true</IsPackable>
    <PackageId>Heimdall.Direct</PackageId>
    <Description>Heimdall native API (HeimdallHub: tracer/logger/meter) for in-process embedding without the OTel SDK. F#-friendly.</Description>
    <PackageTags>otel;opentelemetry;telemetry;embedded;heimdall;fsharp</PackageTags>
    <Version>0.1.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Heimdall.Abstractions\Heimdall.Abstractions.csproj" />
  </ItemGroup>

</Project>