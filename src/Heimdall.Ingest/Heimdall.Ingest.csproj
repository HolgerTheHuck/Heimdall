<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>
    <ImplicitUsings>disable</ImplicitUsings>
    <RootNamespace>Heimdall.Ingest</RootNamespace>
    <AssemblyName>Heimdall.Ingest</AssemblyName>
    <IsPackable>true</IsPackable>
    <PackageId>Heimdall.Ingest</PackageId>
    <Description>Heimdall in-process ingest: bounded buffer, batching, backpressure and recursion guard over IHeimdallSink.</Description>
    <PackageTags>otel;opentelemetry;telemetry;embedded;heimdall</PackageTags>
    <Version>0.1.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Heimdall.Abstractions\Heimdall.Abstractions.csproj" />
  </ItemGroup>

</Project>