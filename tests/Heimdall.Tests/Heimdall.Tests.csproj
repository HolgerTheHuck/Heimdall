<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <RootNamespace>Heimdall.Tests</RootNamespace>
    <AssemblyName>Heimdall.Tests</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.0.1">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <!-- Mvc.Testing 10.0.0 ist net10-only -> Restore wuerde auf net8/9 brechen (NU1202), daher bedingt. -->
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.0"
                      Condition="'$(TargetFramework)' == 'net10.0'" />
    <!-- Nur von OtlpGrpcReceiverTests genutzt (auf net10 gegated). Bedingt, damit net8/9 keine grpc-Transitives ziehen. -->
    <PackageReference Include="Grpc.Net.Client" Version="2.71.0"
                      Condition="'$(TargetFramework)' == 'net10.0'" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Heimdall.Abstractions\Heimdall.Abstractions.csproj" />
    <ProjectReference Include="..\..\src\Heimdall.Ingest\Heimdall.Ingest.csproj" />
    <ProjectReference Include="..\..\src\Heimdall.Direct\Heimdall.Direct.csproj" />
    <ProjectReference Include="..\..\src\Heimdall.Storage.SQLite\Heimdall.Storage.SQLite.csproj" />
    <ProjectReference Include="..\..\src\Heimdall.Sdk\Heimdall.Sdk.csproj" />
    <ProjectReference Include="..\..\src\Heimdall.Otlp\Heimdall.Otlp.csproj" />
    <ProjectReference Include="..\..\src\Heimdall.Otlp.Proto\Heimdall.Otlp.Proto.csproj" />
    <ProjectReference Include="..\..\src\Heimdall.Otlp.Grpc\Heimdall.Otlp.Grpc.csproj" />
    <ProjectReference Include="..\..\src\Heimdall.Prometheus\Heimdall.Prometheus.csproj" />
    <ProjectReference Include="..\..\src\Heimdall.AspNetCore\Heimdall.AspNetCore.csproj" />
    <ProjectReference Include="..\..\src\Heimdall.Blazor\Heimdall.Blazor.csproj" />
    <!-- Host ist net10-only (Microsoft.NET.Sdk.Web) -> ProjectReference bedingt, sonst net8/9-Compile-Bruch. -->
    <ProjectReference Include="..\..\host\Heimdall.Host\Heimdall.Host.csproj"
                      Condition="'$(TargetFramework)' == 'net10.0'" />
  </ItemGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

</Project>